# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (Production and Preview).

# Supabase → Project Settings → API. Both are public (browser-safe) values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. The public address used for canonical links and hreflang tags.
# Defaults to https://aurealounge.de when unset.
# NEXT_PUBLIC_SITE_URL=https://aurealounge.de
